  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.11.0",
    "@types/vue": "^1.0.31",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vue/runtime-dom": "^3.5.29",
    "@vue/tsconfig": "^0.8.1",
    "autoprefixer": "^10.4.27",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.12.0",
    "npm-run-all2": "^8.0.4",
    "postcss": "^8.5.8",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.2.1",
